# Copy to .env and fill in. NEVER commit .env.
# Everything below is OPEN SOURCE and runs locally — no paid accounts or API keys needed.

PORT=3000
NODE_ENV=development

# --- Database (open source; pick one) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/capstone
# DATABASE_URL=sqlite:./data/capstone.db

# --- Vector store (open source; only if your project uses RAG) ---
VECTOR_DB=chroma                 # chroma | qdrant | pgvector | faiss
CHROMA_URL=http://localhost:8000
# QDRANT_URL=http://localhost:6333

# --- Local LLM via Ollama (open weights: llama3.1, mistral, qwen2.5, phi3) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# --- Embeddings (open source) ---
EMBEDDING_PROVIDER=ollama        # ollama | sentence-transformers
EMBEDDING_MODEL=nomic-embed-text

# --- Tracing: OpenTelemetry -> Jaeger (both open source; run Jaeger in Docker) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=capstone-ai

# --- Python AI service (FastAPI, runs LangGraph + the AI tools) that the Node app calls ---
AI_SERVICE_URL=http://localhost:8000

# --- Auth ---
JWT_SECRET=change-me

# --- OPTIONAL: a hosted, OpenAI-compatible API — ONLY if you already have access. Not required. ---
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=
# LLM_API_KEY=
